FROM python:3.11-slim

WORKDIR /app

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV PIP_NO_CACHE_DIR=1
ENV PORT=8080

COPY requirements.ui.txt /app/requirements.ui.txt
RUN pip install --upgrade pip && pip install -r /app/requirements.ui.txt

COPY ui /app/ui

EXPOSE 8080

CMD ["sh", "-c", "exec python -m streamlit run ui/app.py --server.port=${PORT:-8080} --server.address=0.0.0.0 --server.headless=true"]
